APP_NAME=Enlink
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
TRUSTED_PROXIES=127.0.0.1

APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=enlink
DB_USERNAME=enlink
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=local-root-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@enlink.local"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ENLINK_PUBLICATION_CREDIT_COST=1
ENLINK_STARTER_PACKAGE_NAME="Pack inicial"
ENLINK_ANALYTICS_RETENTION_DAYS=90
ENLINK_WEBHOOK_RETENTION_DAYS=180
ENLINK_PAYMENT_RECONCILIATION_HOURS=168

# Opcional en local. Obligatorio al ejecutar seeders en producción.
ENLINK_ADMIN_EMAIL=
ENLINK_ADMIN_PASSWORD=

# En producción: HTTPS obligatorio y cookies solo por conexión segura.
SESSION_SECURE_COOKIE=false

# Mercado Pago: keep these empty until sandbox credentials are available.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_API_URL=https://api.mercadopago.com
