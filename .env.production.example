APP_NAME=Enlink
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-DOMINIO
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=enlink
DB_USERNAME=enlink
DB_PASSWORD=CAMBIAR
MYSQL_ROOT_PASSWORD=CAMBIAR
HTTP_PORT=8080
# Comma-separated CIDRs/IPs of the TLS proxy. For a host-level proxy in the
# default Docker bridge network, 172.16.0.0/12 is a sensible starting point.
# Narrow this to the exact proxy address whenever possible.
TRUSTED_PROXIES=172.16.0.0/12

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=COMPLETAR
MAIL_PORT=587
MAIL_USERNAME=COMPLETAR
MAIL_PASSWORD=COMPLETAR
MAIL_FROM_ADDRESS=COMPLETAR
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

ENLINK_PUBLICATION_CREDIT_COST=1
ENLINK_STARTER_PACKAGE_NAME="Pack inicial"
ENLINK_ANALYTICS_RETENTION_DAYS=90
ENLINK_WEBHOOK_RETENTION_DAYS=180
ENLINK_PAYMENT_RECONCILIATION_HOURS=168
ENLINK_ADMIN_EMAIL=COMPLETAR
ENLINK_ADMIN_PASSWORD=COMPLETAR_CON_12_O_MAS_CARACTERES

MERCADOPAGO_ACCESS_TOKEN=COMPLETAR
MERCADOPAGO_WEBHOOK_SECRET=COMPLETAR
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_API_URL=https://api.mercadopago.com

VITE_APP_NAME="${APP_NAME}"
